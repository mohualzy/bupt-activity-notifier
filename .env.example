# Never commit real credentials. Keep this file as a template.
SECONDCLASS_BASE_URL=https://dekt.bupt.edu.cn

# Option A: direct environment variable, for local --once/--doctor.
SECONDCLASS_TOKEN=replace_with_your_own_token

# Option B: private file read afresh every poll.
# The file takes precedence over SECONDCLASS_TOKEN.
# Windows: SECONDCLASS_TOKEN_FILE=secrets/token.txt
# Docker Compose sets SECONDCLASS_TOKEN_FILE automatically via a read-only secret.
# SECONDCLASS_TOKEN_FILE=secrets/token.txt

POLL_SECONDS=300

# Optional push channels
SERVERCHAN_SENDKEY=
ONEBOT_URL=
ONEBOT_ACCESS_TOKEN=
ONEBOT_USER_ID=
ONEBOT_GROUP_ID=
