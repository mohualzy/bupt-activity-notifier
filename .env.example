# Store this privately as .env; the real token must never be committed.
SECONDCLASS_BASE_URL=https://dekt.bupt.edu.cn
SECONDCLASS_TOKEN=replace_with_your_own_token

# Poll interval is clamped to at least 60 seconds.
POLL_SECONDS=300

# Optional push: ServerChan (WeChat) or OneBot v11 (QQ)
SERVERCHAN_SENDKEY=
ONEBOT_URL=
ONEBOT_ACCESS_TOKEN=
ONEBOT_USER_ID=
ONEBOT_GROUP_ID=
