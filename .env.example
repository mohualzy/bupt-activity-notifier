# Copy to .env privately. Never commit real values or a browser profile.
SECONDCLASS_BASE_URL=https://dekt.bupt.edu.cn
SECONDCLASS_TOKEN=replace_with_your_own_token
SECONDCLASS_COLLEGE_ID=replace_with_your_college_id
SECONDCLASS_CLASS_ID=replace_with_your_class_id
SECONDCLASS_GRADE=replace_with_your_grade
SECONDCLASS_ROLE_ID=replace_with_your_role_id
SECONDCLASS_DIGEST=replace_with_your_digest
SECONDCLASS_IS_GROUP=0
POLL_SECONDS=300

# Optional: ServerChan (WeChat message) and/or OneBot v11 (QQ)
SERVERCHAN_SENDKEY=
ONEBOT_URL=
ONEBOT_ACCESS_TOKEN=
ONEBOT_USER_ID=
ONEBOT_GROUP_ID=
