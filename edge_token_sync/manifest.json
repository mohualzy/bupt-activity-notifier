{
  "manifest_version": 3,
  "name": "北邮第二课堂 · 本机 Token 同步",
  "version": "1.0.0",
  "description": "仅从北邮第二课堂官网登录页同步新 Token 到本机监控；不收集密码或 Cookie。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dekt.bupt.edu.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "北邮二课 Token 同步",
    "default_popup": "popup.html"
  }
}
